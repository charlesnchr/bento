<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- adb's shell has DUMP; apps don't -->
        <receiver android:name=".DebugKeyReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.charles.bento.debug.KEY" />
                <action android:name="com.charles.bento.debug.MIC" />
                <action android:name="com.charles.bento.debug.PIN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
