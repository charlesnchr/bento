#!/bin/bash
# GUI end-to-end test sessions that never fight the user for the machine.
#   scripts/e2e/session start <who> [idle-seconds]   wait until the user has been idle (default 90 s),
#                                                     take the GUI lock, start the input guard, quit the
#                                                     installed Bento (restored on end)
#   scripts/e2e/session check                         exit 75 if the user touched mouse/keyboard
#   scripts/e2e/session end <who>                     stop guard, relaunch installed Bento, release lock
# bentoctl refuses to post events while the user-active flag exists.
set -u
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
. "$ROOT/scripts/config.sh"
FLAG=/tmp/bento-user-active
idle() { ioreg -c IOHIDSystem | awk '/HIDIdleTime/ {print int($NF/1000000000); exit}'; }
build_tools() {
  [ /tmp/bentoctl -nt "$ROOT/scripts/e2e/bentoctl.swift" ] || swiftc -O "$ROOT/scripts/e2e/bentoctl.swift" -o /tmp/bentoctl
  [ /tmp/bento-guard -nt "$ROOT/scripts/e2e/guard.swift" ] || swiftc -O "$ROOT/scripts/e2e/guard.swift" -o /tmp/bento-guard
}
case "${1:-}" in
  start)
    who="${2:-unknown}"; need="${3:-90}"
    build_tools
    while :; do
      while [ "$(idle)" -lt "$need" ]; do i=$(idle); sleep $(( need - i > 5 ? 5 : need - i + 1 )); done
      # The guard starts first and holds the lock's liveness: if the user comes
      # back while we wait for the lock, the guard exits and we start over.
      rm -f "$FLAG"
      /tmp/bento-guard 2>>/tmp/bento-guard.log & gpid=$!
      echo $gpid > /tmp/bento-guard.pid
      sleep 0.3
      if GUI_LOCK_PID=$gpid "$ROOT/scripts/gui-lock" acquire "$who" >/dev/null && kill -0 $gpid 2>/dev/null && [ ! -f "$FLAG" ]; then
        break
      fi
      kill $gpid 2>/dev/null; rm -f /tmp/bento-guard.pid
      [ -d /tmp/bento-gui.lock ] && [ "$(sed -n 1p /tmp/bento-gui.lock/owner 2>/dev/null)" = "$who" ] && rm -rf /tmp/bento-gui.lock
      sleep 5
    done
    if pgrep -f "^$INSTALLED_APP/Contents/MacOS/Bento$" >/dev/null; then
      touch /tmp/bento-e2e-restore
      osascript -e 'tell application id "com.charles.bento" to quit' >/dev/null 2>&1
      for _ in $(seq 1 20); do pgrep -f "^$INSTALLED_APP/Contents/MacOS/Bento$" >/dev/null || break; sleep 0.25; done
    fi
    echo "session started for $who (user idle, guard running)" ;;
  check)
    [ -f "$FLAG" ] && { cat "$FLAG"; exit 75; }; exit 0 ;;
  end)
    who="${2:-unknown}"
    [ -f /tmp/bento-guard.pid ] && kill "$(cat /tmp/bento-guard.pid)" 2>/dev/null; rm -f /tmp/bento-guard.pid
    if [ -f /tmp/bento-e2e-restore ]; then rm -f /tmp/bento-e2e-restore; open -g "$INSTALLED_APP"; fi
    "$ROOT/scripts/gui-lock" release "$who" >/dev/null
    [ -f "$FLAG" ] && echo "session ended early: $(cat $FLAG)" || echo "session ended" ;;
  *) echo "usage: $0 start|check|end <who> [idle-seconds]" >&2; exit 2 ;;
esac
